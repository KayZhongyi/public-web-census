#!/usr/bin/env python3
"""Repository CLI for Competitor Census."""

from __future__ import annotations

import subprocess
import sys
from pathlib import Path


ROOT = Path(__file__).resolve().parent
COMMANDS = {
    "setup": "setup.py",
    "doctor": "doctor.py",
    "export": "export_report.py",
    "install-skill": "install_skill.py",
    "demo": "run_demo.py",
    "facebook": "collect_facebook.py",
    "tiktok": "collect_tiktok.py",
    "tiktok-comments": "collect_tiktok_comments.py",
    "youtube": "collect_youtube.py",
    "youtube-comments": "collect_youtube_comments.py",
    "prepare-analysis": "prepare_analysis.py",
    "apply-analysis": "apply_analysis.py",
    "prepare-voice": "prepare_customer_voice.py",
    "apply-voice": "apply_customer_voice.py",
    "merge": "merge_incremental.py",
}


def print_help() -> None:
    print(
        """Competitor Census CLI

Usage:
  ./competitor-census <command> [options]

Live collection:
  tiktok           Collect a public TikTok profile grid with dates, captions,
                   views, stable IDs, and source links through OpenCLI
  tiktok-comments  Collect public comments and replies for selected TikTok
                   evidence records; human verification is never bypassed
  facebook          Collect public Facebook Page posts through an authorized
                    Chrome session using the OpenCLI browser bridge
  youtube           Collect public YouTube channel metadata with yt-dlp
  youtube-comments  Deep-read selected public YouTube video conversations
                   with yt-dlp; no API key or media download

Setup:
  setup             Guide OpenCLI installation, open the official Chrome
                    extension page, and verify the local browser bridge
  doctor            Check the local runtime and optional live connectors
  install-skill     Link this clone into Codex and/or Claude Code skills

Delivery:
  export            Export an HTML report to vector PDF with Chrome/Chromium

Evidence workflow:
  demo              Build the fictional offline report
  prepare-analysis  Create an Agent analysis packet
  apply-analysis    Validate and merge completed analysis
  prepare-voice     Create a customer-voice analysis packet
  apply-voice       Validate customer-voice analysis
  merge             Merge a new capture into a baseline by stable ID

Run './competitor-census <command> --help' for command-specific options.
"""
    )


def main(argv: list[str] | None = None) -> int:
    args = list(sys.argv[1:] if argv is None else argv)
    if not args or args[0] in {"-h", "--help", "help"}:
        print_help()
        return 0
    if args[0] in {"-V", "--version"}:
        print("competitor-census 0.8.0")
        return 0

    command = args.pop(0)
    script = COMMANDS.get(command)
    if script is None:
        print(f"Unknown command: {command}\n", file=sys.stderr)
        print_help()
        return 2

    completed = subprocess.run([sys.executable, str(ROOT / "scripts" / script), *args])
    return completed.returncode


if __name__ == "__main__":
    raise SystemExit(main())
