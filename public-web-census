#!/usr/bin/env python3
"""Repository CLI for Public Web Census."""

from __future__ import annotations

import subprocess
import sys
from pathlib import Path


ROOT = Path(__file__).resolve().parent
COMMANDS: dict[str, tuple[str, list[str]]] = {
    "setup": ("setup.py", []),
    "doctor": ("doctor.py", []),
    "export": ("export_report.py", []),
    "install-skill": ("install_skill.py", []),
    "demo": ("run_demo.py", []),
    "facebook": ("collect_facebook.py", []),
    "tiktok": ("collect_tiktok.py", []),
    "tiktok-comments": ("collect_tiktok_comments.py", []),
    "youtube": ("collect_youtube.py", []),
    "youtube-comments": ("collect_youtube_comments.py", []),
    "prepare-analysis": ("prepare_analysis.py", []),
    "apply-analysis": ("apply_analysis.py", []),
    "prepare-voice": ("prepare_customer_voice.py", []),
    "apply-voice": ("apply_customer_voice.py", []),
    "local-analysis": ("local_analysis.py", []),
    "merge": ("merge_incremental.py", []),
    "discover": ("evidence_store.py", ["init"]),
    "ingest": ("evidence_store.py", ["ingest"]),
    "refresh": ("evidence_store.py", ["ingest"]),
    "diff": ("evidence_store.py", ["diff"]),
    "validate": ("evidence_store.py", ["validate"]),
    "snapshot": ("evidence_store.py", ["export"]),
    "history": ("evidence_store.py", ["history"]),
}
COLLECTORS = {
    "facebook": "collect_facebook.py",
    "tiktok": "collect_tiktok.py",
    "tiktok-comments": "collect_tiktok_comments.py",
    "youtube": "collect_youtube.py",
    "youtube-comments": "collect_youtube_comments.py",
}
ANALYSIS_MODES = {
    "content": "prepare_analysis.py",
    "customer-voice": "prepare_customer_voice.py",
}


