    )


def run_script(script: str, args: list[str]) -> int:
    completed = subprocess.run([sys.executable, str(ROOT / "scripts" / script), *args])
    return completed.returncode


def take_option(args: list[str], name: str) -> str | None:
    prefix = f"{name}="
    for index, value in enumerate(list(args)):
        if value.startswith(prefix):
            args.pop(index)
            return value[len(prefix) :]
        if value == name:
            if index + 1 >= len(args):
                raise SystemExit(f"{name} requires a value")
            result = args[index + 1]
            del args[index : index + 2]
            return result
    return None


def find_option(args: list[str], name: str) -> str | None:
    prefix = f"{name}="
    for index, value in enumerate(args):
        if value.startswith(prefix):
            return value[len(prefix) :]
        if value == name and index + 1 < len(args):
            return args[index + 1]
    return None


def collect(args: list[str]) -> int:
    if not args or args[0] in {"-h", "--help", "help"}:
        print(
            "Usage: ./public-web-census collect <platform> [--workspace PATH] "
            "[--ingest-label LABEL] <connector options>\n\n"
            "Platforms: facebook, tiktok, tiktok-comments, youtube, youtube-comments\n"
            "When --workspace is supplied, use --output for profile/channel collectors or "
            "--bundle for comment collectors. A successful capture is archived and ingested."
        )
        return 0
    platform = args.pop(0)
    script = COLLECTORS.get(platform)
    if script is None:
        print(f"Unknown collection platform: {platform}", file=sys.stderr)
        return 2
    workspace = take_option(args, "--workspace")
    label = take_option(args, "--ingest-label")
    bundle_option = "--bundle" if platform.endswith("comments") else "--output"
    bundle = find_option(args, bundle_option)
    if workspace and not bundle:
        print(
            f"collect {platform} with --workspace also requires {bundle_option} PATH",
            file=sys.stderr,
        )
        return 2
    result = run_script(script, args)
    if result or not workspace:
        return result
    ingest_args = ["ingest", "--workspace", workspace, "--bundle", str(Path(bundle).resolve())]
    if label:
        ingest_args.extend(["--label", label])
    return run_script("evidence_store.py", ingest_args)


def analyze(args: list[str]) -> int:
    if not args or args[0] in {"-h", "--help", "help"}:
        print(
            "Usage: ./public-web-census analyze <content|customer-voice> "
            "(--workspace PATH | --bundle PATH)\n\n"
            "This prepares a validated Agent handoff. Use apply-analysis or apply-voice "
            "after the Agent completes the packet."
        )
        return 0
    mode = args.pop(0)
    script = ANALYSIS_MODES.get(mode)
    if script is None:
        print(f"Unknown analysis mode: {mode}", file=sys.stderr)
        return 2
    workspace = take_option(args, "--workspace")
    if workspace:
        if find_option(args, "--bundle"):
            print("Use either --workspace or --bundle, not both", file=sys.stderr)
            return 2
        args.extend(["--bundle", str(Path(workspace).resolve() / "current")])
    if not find_option(args, "--bundle"):
        print("analyze requires --workspace PATH or --bundle PATH", file=sys.stderr)
        return 2
    return run_script(script, args)


def main(argv: list[str] | None = None) -> int:
    args = list(sys.argv[1:] if argv is None else argv)
    if not args or args[0] in {"-h", "--help", "help"}:
        print_help()
        return 0
    if args[0] in {"-V", "--version"}:
        print("public-web-census 1.1.0")
        return 0

    command = args.pop(0)
    if command == "collect":
        return collect(args)
    if command == "analyze":
        return analyze(args)
    specification = COMMANDS.get(command)
    if specification is None:
        print(f"Unknown command: {command}\n", file=sys.stderr)
        print_help()
        return 2
    script, prefix = specification
    return run_script(script, [*prefix, *args])


if __name__ == "__main__":
    raise SystemExit(main())
